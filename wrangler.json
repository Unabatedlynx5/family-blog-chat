{
  "name": "family-blog-chat",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-08",
  "vars": {
    "JWT_SECRET": "ensure-this-is-set-in-dashboard-or-dev-vars"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GLOBAL_CHAT",
        "class_name": "GlobalChat"
      },
      {
        "name": "POST_ROOM",
        "class_name": "PostRoom"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family_blog_db",
      "database_id": "27f6f3e9-aa0b-438b-9caf-338439859061"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GlobalChat"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "PostRoom"
      ]
    }
  ]
}
